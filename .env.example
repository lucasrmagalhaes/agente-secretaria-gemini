# Chave gratuita do Google AI Studio: https://aistudio.google.com/apikey
# Não ative faturamento se quiser permanecer no plano gratuito.
GEMINI_API_KEY=

# Modelo Flash do plano gratuito. gemini-2.5-flash não está mais disponível para contas novas.
GEMINI_MODEL=gemini-3.8-flash

# Opcional. Usado só depois que o modelo principal esgota as tentativas de 429 e 503.
# GEMINI_FALLBACK_MODEL=

# JSON do cliente OAuth do tipo computador, baixado do Google Cloud.
GOOGLE_CREDENTIALS_PATH=./secrets/credentials.json

# Onde o login salva o token. Não commite este arquivo.
GOOGLE_TOKEN_PATH=./secrets/token.json

GOOGLE_CALENDAR_ID=primary

# Fuso usado para "hoje" e para os horários do calendário.
CALENDAR_TIMEZONE=America/Sao_Paulo

# dry-run só imprime o e-mail. gmail envia e lista a caixa real (exige novo npm run auth).
EMAIL_MODE=dry-run

# Quantas rodadas de ferramenta o loop ReAct aceita por mensagem.
MAX_TOOL_STEPS=8
